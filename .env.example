# ==============================================================================
# Solar Pulse — Client Environment Configuration (.env)
# ==============================================================================
# IMPORTANT:
# 1. Only client-safe keys belong in VITE_ variables.
# 2. Never put secret keys (Paystack Secret, Flutterwave Secret/Hash) in VITE_ variables.
# 3. Restrict your Firebase Web API Key by HTTP referrer (domain) in Google Cloud Console.

# Firebase Web App Configuration (Required)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloud Functions Region (Must match region in functions/index.js, e.g. europe-west1)
VITE_FUNCTIONS_REGION=europe-west1

# Payment Gateway Public Keys (Client Checkout SDKs)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_flutterwave_public_key

# Admin Email (UI Hint only — authoritative admin rights require custom auth token claims)
VITE_ADMIN_EMAIL=admin@solarpulse.io

# Direct Corporate Bank Transfer Details (Optional)
VITE_BANK_NAME="Zenith Bank"
VITE_BANK_ACCOUNT_NAME="Solar Pulse Technologies Ltd"
VITE_BANK_ACCOUNT_NUMBER="1012345678"

# ==============================================================================
# Firebase Cloud Functions Secrets (Configure via `firebase functions:secrets:set`)
# ==============================================================================
# PAYSTACK_SECRET_KEY=sk_test_...
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
# FLUTTERWAVE_SECRET_HASH=your_webhook_verification_hash
# APP_URL=https://your-project.web.app
