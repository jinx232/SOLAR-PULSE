rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Authoritative admin check: strictly requires the custom auth token claim `admin: true` OR the owner email.
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'odumesamuel52@gmail.com')
      );
    }

    match /presence/{userId} {
      allow create, update: if request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'lastActiveAt', 'platform', 'path'
        ])
        && request.resource.data.uid is string
        && request.resource.data.lastActiveAt is number
        && (
          (isSignedIn() && request.auth.uid == userId && request.resource.data.uid == userId) ||
          (!isSignedIn() && userId.matches('^session_[a-z0-9]+$') && request.resource.data.uid == userId)
        );
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      // Restrict presence reads to the record owner and administrators
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/projects/{projectId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /subscriptions/{userId} {
      // Subscription records are written only by trusted server webhooks.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /pendingTransactions/{txId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if false;
    }

    match /supportTickets/{ticketId} {
      // Length caps, field allowlist, and bot/spoof mitigation
      allow create: if request.resource.data.keys().hasOnly([
                        'name', 'email', 'message', 'category', 'priority', 'platform',
                        'subject', 'userId', 'source', 'status', 'createdAt', 'recipientEmail'
                      ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 3
                    && request.resource.data.email.size() <= 120
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 10
                    && request.resource.data.message.size() <= 3000
                    && (!('status' in request.resource.data) || request.resource.data.status in ['open', 'pending'])
                    && (!('subject' in request.resource.data) || (request.resource.data.subject is string && request.resource.data.subject.size() <= 200))
                    && (!('category' in request.resource.data) || (request.resource.data.category is string && request.resource.data.category.size() <= 50))
                    && (!('priority' in request.resource.data) || (request.resource.data.priority is string && request.resource.data.priority.size() <= 30))
                    && (!('platform' in request.resource.data) || (request.resource.data.platform is string && request.resource.data.platform.size() <= 30))
                    && (!('source' in request.resource.data) || (request.resource.data.source is string && request.resource.data.source.size() <= 50))
                    && (!('recipientEmail' in request.resource.data) || (request.resource.data.recipientEmail is string && request.resource.data.recipientEmail.size() <= 120))
                    && (!('userId' in request.resource.data) || request.resource.data.userId == null || (isSignedIn() && request.resource.data.userId == request.auth.uid));
      // Only administrators can review, resolve, and manage tickets
      allow read, list, update, delete: if isAdmin();
    }
  }
}
